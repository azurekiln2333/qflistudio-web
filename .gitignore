/apps/qfli_c/ohos/**/node_modules/
/apps/qfli_c/ohos/**/.hvigor/
/apps/qfli_c/ohos/entry/libs/

# The same generated platform directories exist in every language App.
**/ohos/**/build/
**/ohos/**/oh_modules/
**/ohos/**/node_modules/
**/ohos/**/.hvigor/
**/ohos/entry/libs/

# Native language runtime build output
**/native/build/
/assets/runtime/nginx/linux/
/assets/runtime/nginx/macos/
# Durable Trellis instructions, tasks, scripts and journals are versioned.
# .trellis/.gitignore excludes per-session runtime and private identity.
#
# Portable agent integration sources are reviewed and tracked. Each integration
# root is excluded, then reopened for directory traversal only, then each
# reviewed template file is allowed by its exact path. An unreviewed file inside
# these roots stays ignored, so a plain `git add` stages only reviewed content.
# Private runtime and session state stay untracked even inside an allowed tree.
/.claude/**
!/.claude/**/
/.codebuddy/**
!/.codebuddy/**/
/.cursor/**
!/.cursor/**/
/.pi/**
!/.pi/**/
/.zcode/**
!/.zcode/**/
/.dsh/**
!/.dsh/**/
!/.claude/agents/trellis-check.md
