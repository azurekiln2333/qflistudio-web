# Runtime and private state: never stage these even inside an allowed tree.
/.claude/settings.local.json
/.codebuddy/settings.local.json
/.cursor/*.local.json
/.pi/agent/
/.dsh/.runtime/
/.trellis/.runtime/
**/sessions/
**/logs/

# Local agent tools with no reviewed template stay excluded.
/.agent/
/.gemini/
/.qoder/
/.workbuddy-ai/
**/__pycache__/

# Generated dependencies and compiler/packaging output stay in cloud runners.
**/node_modules/
**/.gradle/
**/.kotlin/
**/.cxx/
**/CMakeFiles/
**/CMakeCache.txt
/dist/
/out/
/artifacts/
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/

# A legacy extracted Nginx scratch tree has a single-space directory name.
# Preserve it for the scoped cleanup audit; never stage it as product source.
/[ ]/

# Signing material and local secrets must never enter a new commit.
.env
.env.*
!.env.example
*.jks
*.keystore
*.p12
*.pfx
*.mobileprovision
*.provisionprofile
key.properties
*.local.json5

# Local diagnostic exports and shell inspection fragments
/_*.txt
/tmp_*.txt
/s[1-5].txt
/rc[1-2].txt
/run_chunk.txt
/corelist.txt
/lib_tree.txt
/.dsh_*.txt
/.dsh_tmp/
/.gitstatus.txt
/.gs.txt
/.st.txt

# Local browser tooling used to validate the bundled Web curriculum.
/node_modules/
