+cmake_minimum_required(VERSION 3.20)
+project(qfli_mysql_desktop LANGUAGES CXX)
+
+set(QFLI_MYSQL_SOURCE "$ENV{QFLI_MYSQL_SOURCE}" CACHE PATH "Pinned Oracle source tree (RapidJSON headers)")
+if(NOT QFLI_MYSQL_SOURCE)
+  set(QFLI_MYSQL_SOURCE "${CMAKE_CURRENT_SOURCE_DIR}/../../../build/mysql-port/mysql-8.4.6")
+endif()
+set(QFLI_ORACLE_HOME "$ENV{QFLI_ORACLE_HOME}" CACHE PATH "Official Oracle MySQL server distribution")
+find_path(RAPIDJSON_INCLUDE_DIR rapidjson/document.h
+  HINTS "${QFLI_MYSQL_SOURCE}/extra/rapidjson/include" REQUIRED)
+if(WIN32 OR APPLE)
+  find_path(ORACLE_INCLUDE mysql.h HINTS "${QFLI_ORACLE_HOME}/include" NO_DEFAULT_PATH REQUIRED)
+  find_library(ORACLE_LIBRARY NAMES libmysql mysqlclient
+    HINTS "${QFLI_ORACLE_HOME}/lib" NO_DEFAULT_PATH REQUIRED)
+else()
+  find_package(PkgConfig REQUIRED)
+  pkg_check_modules(ORACLE REQUIRED IMPORTED_TARGET mysqlclient)
+  set(ORACLE_LIBRARY PkgConfig::ORACLE)
+endif()
+
+add_library(qfli_mysql_bridge SHARED ../../src/qfli_mysql_client.cpp ../../src/qfli_mysql_ffi.cpp)
+target_include_directories(qfli_mysql_bridge PRIVATE ../../src)
+if(ORACLE_INCLUDE)
+  target_include_directories(qfli_mysql_bridge SYSTEM PRIVATE "${ORACLE_INCLUDE}")
+endif()
+target_include_directories(qfli_mysql_bridge SYSTEM PRIVATE "${RAPIDJSON_INCLUDE_DIR}")
+target_link_libraries(qfli_mysql_bridge PRIVATE ${ORACLE_LIBRARY})
+target_compile_features(qfli_mysql_bridge PRIVATE cxx_std_17)
+set_target_properties(qfli_mysql_bridge PROPERTIES CXX_VISIBILITY_PRESET hidden)
+if(WIN32)
+  set_target_properties(qfli_mysql_bridge PROPERTIES PREFIX "")
+elseif(UNIX AND NOT APPLE)
+  set_target_properties(qfli_mysql_bridge PROPERTIES INSTALL_RPATH "$ORIGIN")
+endif()
+add_executable(qfli_mysql_launcher launcher.cpp)
+target_compile_features(qfli_mysql_launcher PRIVATE cxx_std_17)
+if(MINGW)
+  target_link_options(qfli_mysql_bridge PRIVATE -static)
+  target_link_options(qfli_mysql_launcher PRIVATE -static -municode)
+endif()
+foreach(target qfli_mysql_bridge qfli_mysql_launcher)
+  if(MSVC)
+    target_compile_options(${target} PRIVATE /W4 /EHsc)
+  else()
+    target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
+  endif()
+endforeach()
+install(TARGETS qfli_mysql_bridge qfli_mysql_launcher
+  RUNTIME DESTINATION qfli_mysql/bin LIBRARY DESTINATION qfli_mysql/lib)
+if(QFLI_ORACLE_HOME)
+  if(NOT EXISTS "${QFLI_ORACLE_HOME}/bin/mysqld${CMAKE_EXECUTABLE_SUFFIX}")
+    message(FATAL_ERROR "Stage the full Oracle server distribution before packaging: ${QFLI_ORACLE_HOME}")
+  endif()
+  foreach(directory bin lib share docs licenses)
+    if(EXISTS "${QFLI_ORACLE_HOME}/${directory}")
+      install(DIRECTORY "${QFLI_ORACLE_HOME}/${directory}/"
+        DESTINATION "qfli_mysql/${directory}" COMPONENT Runtime
+        PATTERN "*.pdb" EXCLUDE PATTERN "*-debug.*" EXCLUDE
+        PATTERN "*.a" EXCLUDE PATTERN "*.lib" EXCLUDE)
+    endif()
+  endforeach()
+  foreach(file LICENSE README runtime.json)
+    if(EXISTS "${QFLI_ORACLE_HOME}/${file}")
+      install(FILES "${QFLI_ORACLE_HOME}/${file}" DESTINATION qfli_mysql COMPONENT Runtime)
+    endif()
+  endforeach()
+  if(WIN32)
+    install(FILES "${QFLI_ORACLE_HOME}/lib/libmysql.dll" DESTINATION qfli_mysql/bin COMPONENT Runtime)
+  endif()
+endif()
diff --git a/native/mysql/desktop/README.md b/native/mysql/desktop/README.md
new file mode 100644
index 0000000..f62c2a3
--- /dev/null
+++ b/native/mysql/desktop/README.md
@@ -0,0 +1,90 @@
+# Oracle MySQL Desktop Runtime
+
+Windows and Linux use the actual upstream Oracle server and C client. The
+adapter in `lib/mysql_database.dart` starts the private server through
+`LocalMySqlRuntime` and invokes `qfli_mysql_bridge` on worker isolates. Explicit
+injected channels retain their existing behavior. No TCP service is opened and
+no SQLite or cloud fallback is performed.
+
+## Build And Package
+
+Windows x64 input is the official Oracle MySQL 8.4.6 ZIP:
+
+- URL: `https://cdn.mysql.com/archives/mysql-8.4/mysql-8.4.6-winx64.zip`
+- SHA256: `b6c152f9f3aaa7294eb47db698e47974d37b261bf3cab4f90dc1243bb5ecd204`
+
+Stage it before the Windows Flutter build:
+
+```powershell
+./native/mysql/desktop/stage-windows.ps1 -Archive <path-to-official-zip>
+$env:QFLI_MYSQL_SOURCE = '<verified-mysql-8.4.6-source-tree>'
+flutter build windows
+```
+
+The pinned Oracle source tree supplies its RapidJSON headers; source provenance
+and extraction instructions are in `native/mysql/README.md`. The default source
+location is `build/mysql-port/mysql-8.4.6`. The official Microsoft Visual C++
+runtime required by Oracle must be installed on the target Windows host.
+
+Linux staging uses installed **Oracle** development/server packages. It rejects
+MariaDB and copies the server, resources, plugins and resolved native dependency
+chain. Host libc and the dynamic loader remain system prerequisites:
+
+```bash
+bash native/mysql/desktop/stage-linux.sh
+export QFLI_MYSQL_SOURCE=<verified-mysql-8.4.6-source-tree>
+flutter build linux
+```
+
+`QFLI_ORACLE_HOME` overrides the staged distribution location. Windows/Linux
+plugin CMake installs the complete runtime into `qfli_mysql/` beside the app.
+Missing runtime inputs fail desktop packaging. Standalone native builds use:
+
+```bash
+cmake -S native/mysql/desktop -B native/build/mysql-client \
+  -DQFLI_MYSQL_SOURCE=<verified-source> -DQFLI_ORACLE_HOME=<staged-distribution>
+cmake --build native/build/mysql-client
+cmake --install native/build/mysql-client --prefix <installation-root>
+```
+
+The launcher lives in `qfli_mysql/bin`. Windows keeps the bridge and Oracle DLL
+dependencies in `bin`; Linux keeps the bridge and shared libraries in `lib`.
+The runtime explicitly points mysqld at its bundled resources and plugins.
+Retain all upstream LICENSE/docs and source/build provenance in release bundles.
+
+## Lifecycle
+
+The default storage is the user's local application data under `qfli_sql/mysql`.
+`QFLI_MYSQL_BUNDLE` overrides runtime discovery. The test constructor can inject
+an isolated data directory; it never silently substitutes a system server.
+
+Initialization runs in a private staging directory. Only a successful Oracle
+initialization is moved to `data`; `initialized.json` records the exact server
+version and a random 256-bit local password. Existing data without a successful
+marker or a different version returns unavailable; automatic upgrade is disabled.
+`root.sql` installs that credential before accepting queries. Unix storage files
+are mode 600, directories/socket parents 700. Windows uses the user's local data
+ACL, an unpredictable pipe name and Oracle RSA password exchange over that pipe.
+
+A lifetime file lock and process-local registry prevent a second runtime from
+using the same directory. Queries and stop are serialized. Stop invokes Oracle
+shutdown, waits, and terminates only the owned launcher on timeout. Linux
+PDEATHSIG and the Windows creation-time Job Object terminate the owned server
+after application death. `stop()` releases its transport and lock while keeping
+database contents. Server diagnostics and failed initialization are reported.
+
+## Verification And Remaining Platforms
+
+Run `native/mysql/desktop/runtime_test.dart` with the bundle, bridge and launcher
+paths. It checks real initialization, ownership, exact values, parameter errors,
+scripts/transactions, output caps, credentials, persistence, stop, parent death
+and recovery. It retains its isolated fixture for diagnostics. Set
+`QFLI_MYSQL_TEST_BUNDLE` for `test/mysql_desktop_database_test.dart`; these tests
+exercise the typed application adapter using a temporary database.
+
+Windows Oracle 8.4.6 and Linux Oracle 8.0.46 have real-engine evidence. Full
+Windows Flutter GUI build remains unverified without MSVC; Linux Flutter GUI
+and Apple execution have not been tested. Portable macOS launcher/runtime source
+exists, but macOS bundle/signing integration is still required. Android server
+build/lifecycle, native iOS hosting and the product's local-MySQL engine selector
+remain open requirements. This backend delivery does not establish them.
diff --git a/native/mysql/desktop/launcher.cpp b/native/mysql/desktop/launcher.cpp
new file mode 100644
index 0000000..b97ccc8
--- /dev/null
+++ b/native/mysql/desktop/launcher.cpp
@@ -0,0 +1,129 @@
+#include <cstdlib>
+#include <iostream>
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <string>
+#include <vector>
+
+namespace {
+std::wstring quote(const wchar_t *argument)
+{
+    std::wstring value = L"\"";
+    size_t slashes = 0;
+    for (const wchar_t *cursor = argument; *cursor; ++cursor) {
+        if (*cursor == L'\\') { ++slashes; continue; }
+        value.append(slashes * (*cursor == L'"' ? 2 : 1), L'\\');
+        slashes = 0;
+        if (*cursor == L'"') value += L'\\';
+        value += *cursor;
+    }
+    value.append(slashes * 2, L'\\');
+    return value + L'"';
+}
+}
+
+int wmain(int argc, wchar_t **argv)
+{
+    if (argc < 3) return 64;
+    wchar_t *end = nullptr;
+    const auto owner_id = std::wcstoul(argv[1], &end, 10);
+    if (!end || *end || !owner_id || owner_id > MAXDWORD) return 64;
+    HANDLE owner = OpenProcess(SYNCHRONIZE, FALSE, static_cast<DWORD>(owner_id));
+    if (!owner || WaitForSingleObject(owner, 0) != WAIT_TIMEOUT) return 65;
+    HANDLE job = CreateJobObjectW(nullptr, nullptr);
+    JOBOBJECT_EXTENDED_LIMIT_INFORMATION limits{};
+    limits.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+    if (!job || !SetInformationJobObject(job, JobObjectExtendedLimitInformation, &limits, sizeof(limits))) return 66;
+
+    // Assign the child to its lifetime job at creation, before it can execute.
+    SIZE_T size = 0;
+    InitializeProcThreadAttributeList(nullptr, 1, 0, &size);
+    std::vector<char> storage(size);
+    auto *attributes = reinterpret_cast<LPPROC_THREAD_ATTRIBUTE_LIST>(storage.data());
+    if (!InitializeProcThreadAttributeList(attributes, 1, 0, &size) ||
+        !UpdateProcThreadAttribute(attributes, 0, PROC_THREAD_ATTRIBUTE_JOB_LIST,
+                                   &job, sizeof(job), nullptr, nullptr)) return 67;
+    STARTUPINFOEXW startup{};
+    startup.StartupInfo.cb = sizeof(startup);
+    startup.StartupInfo.dwFlags = STARTF_USESTDHANDLES;
+    startup.StartupInfo.hStdInput = GetStdHandle(STD_INPUT_HANDLE);
+    startup.StartupInfo.hStdOutput = GetStdHandle(STD_OUTPUT_HANDLE);
+    startup.StartupInfo.hStdError = GetStdHandle(STD_ERROR_HANDLE);
+    startup.lpAttributeList = attributes;
+    std::wstring command;
+    for (int index = 2; index < argc; ++index) {
+        if (index != 2) command += L' ';
+        command += quote(argv[index]);
+    }
+    PROCESS_INFORMATION process{};
+    const BOOL started = CreateProcessW(argv[2], command.data(), nullptr, nullptr, TRUE,
+        EXTENDED_STARTUPINFO_PRESENT | CREATE_NO_WINDOW, nullptr, nullptr, &startup.StartupInfo, &process);
+    DeleteProcThreadAttributeList(attributes);
+    if (!started) return 68;
+    CloseHandle(process.hThread);
+    HANDLE handles[] = {owner, process.hProcess};
+    const DWORD waited = WaitForMultipleObjects(2, handles, FALSE, INFINITE);
+    if (waited != WAIT_OBJECT_0 + 1) TerminateJobObject(job, 125);
+    WaitForSingleObject(process.hProcess, INFINITE);
+    DWORD status = 125;
+    GetExitCodeProcess(process.hProcess, &status);
+    CloseHandle(process.hProcess);
+    CloseHandle(owner);
+    CloseHandle(job);
+    return static_cast<int>(status);
+}
+#else
+#include <cerrno>
+#include <csignal>
+#include <unistd.h>
+#ifdef __linux__
+#include <sys/prctl.h>
+#else
+#include <sys/event.h>
+#include <sys/wait.h>
+#endif
+
+int main(int argc, char **argv)
+{
+    if (argc < 3) return 64;
+    char *end = nullptr;
+    const long owner = std::strtol(argv[1], &end, 10);
+    if (!end || *end || owner <= 0 || owner != getppid()) return 65;
+#ifdef __linux__
+    if (prctl(PR_SET_PDEATHSIG, SIGTERM) != 0 || getppid() != owner) return 66;
+    execv(argv[2], argv + 2);
+    std::cerr << "Could not execute bundled mysqld: " << errno << '\n';
+    return 68;
+#else
+    const int queue = kqueue();
+    if (queue < 0) return 66;
+    struct kevent parent;
+    EV_SET(&parent, owner, EVFILT_PROC, EV_ADD | EV_ONESHOT, NOTE_EXIT, 0, nullptr);
+    if (kevent(queue, &parent, 1, nullptr, 0, nullptr) != 0 || getppid() != owner) return 66;
+    const pid_t child = fork();
+    if (child < 0) return 67;
+    if (child == 0) { close(queue); execv(argv[2], argv + 2); _exit(68); }
+    struct kevent child_event;
+    EV_SET(&child_event, child, EVFILT_PROC, EV_ADD | EV_ONESHOT, NOTE_EXIT, 0, nullptr);
+    if (kevent(queue, &child_event, 1, nullptr, 0, nullptr) != 0) {
+        kill(child, SIGKILL); waitpid(child, nullptr, 0); return 67;
+    }
+    struct kevent event;
+    if (kevent(queue, nullptr, 0, &event, 1, nullptr) <= 0 || event.ident == static_cast<uintptr_t>(owner)) {
+        kill(child, SIGTERM);
+        for (int attempt = 0; attempt < 100; ++attempt) {
+            int status;
+            if (waitpid(child, &status, WNOHANG) == child) return 125;
+            usleep(100000);
+        }
+        kill(child, SIGKILL);
+    }
+    int status = 0;
+    while (waitpid(child, &status, 0) < 0 && errno == EINTR) {}
+    close(queue);
+    return WIFEXITED(status) ? WEXITSTATUS(status) : 125;
+#endif
+}
+#endif
diff --git a/native/mysql/desktop/runtime_test.dart b/native/mysql/desktop/runtime_test.dart
new file mode 100644
index 0000000..fd974a4
--- /dev/null
+++ b/native/mysql/desktop/runtime_test.dart
@@ -0,0 +1,331 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+import 'dart:isolate';
+
+import 'package:path/path.dart' as p;
+
+import 'package:qfli_sql/local_mysql_runtime.dart';
+import 'package:qfli_sql/mysql_ffi.dart';
+
+void require(bool condition, String message) {
+  if (!condition) throw StateError('FAIL: $message');
+}
+
+void success(Map<String, Object?> result) {
+  require(result['available'] == true && result['exitCode'] == 0, '$result');
+}
+
+Future<void> main(List<String> arguments) async {
+  final orphan = arguments.first == '--parent-server';
+  final args = orphan ? arguments.sublist(1) : arguments;
+  require(args.length >= 3, 'pass bundle, bridge library and launcher');
+  final root = orphan
+      ? Directory(args[3])
+      : await Directory.systemTemp.createTemp('qfli-mysql-test-');
+  LocalMySqlRuntime createRuntime() => LocalMySqlRuntime(
+    bundleDirectory: Directory(args[0]),
+    dataDirectory: root,
+    libraryPath: args[1],
+    launcherPath: args[2],
+    serverPath: Platform.environment['QFLI_MYSQL_TEST_SERVER'],
+    serverUser: Platform.environment['QFLI_MYSQL_TEST_USER'],
+  );
+  var runtime = createRuntime();
+  Future<Map<String, Object?>> query(
+    String source, [
+    List<String?> params = const [],
+    String schema = 'lab',
+  ]) => runtime.invoke('query', {
+    'schema': schema,
+    'source': source,
+    'params': params,
+  });
+  Future<Map<String, Object?>> script(String source) =>
+      runtime.invoke('executeScript', {'schema': 'lab', 'source': source});
+  if (orphan) {
+    final result = await query('SELECT @@socket, @@pid_file', [], '');
+    success(result);
+    final values = (result['rows'] as List).single as List;
+    final serverPid = int.parse(
+      (await File(values[1] as String).readAsString()).trim(),
+    );
+    stdout.writeln(
+      'READY ${jsonEncode({'socket': values[0], 'pid': serverPid})}',
+    );
+    await Future<void>.delayed(const Duration(minutes: 20));
+    await runtime.stop();
+    return;
+  }
+  var passed = 0;
+  void pass(String label) {
+    passed++;
+    stdout.writeln('PASS $label');
+  }
+
+  try {
+    final version = await query(
+      'SELECT VERSION(), @@version_comment, @@skip_networking',
+      [],
+      '',
+    );
+    success(version);
+    require(
+      RegExp(r'^8\.\d+\.\d+').hasMatch(
+            ((version['rows'] as List).single as List).first as String,
+          ) &&
+          !version.toString().contains('MariaDB'),
+      'real Oracle engine',
+    );
+    require(
+      ((version['rows'] as List).single as List)[2] == '1',
+      'TCP disabled',
+    );
+    pass('actual upstream initialization and private transport');
+
+    final duplicate = createRuntime();
+    final locked = await duplicate.invoke('query', {
+      'schema': '',
+      'source': 'SELECT 1',
+      'params': <String?>[],
+    });
+    require(
+      locked['available'] == false &&
+          locked['error'].toString().contains('already in use'),
+      'duplicate owner rejected',
+    );
+    await duplicate.stop();
+    pass('exclusive data-directory ownership');
+
+    success(await query('CREATE DATABASE lab', [], ''));
+    success(
+      await query(
+        'CREATE TABLE items (id BIGINT PRIMARY KEY, amount DECIMAL(30,6), note TEXT, bytes BLOB)',
+      ),
+    );
+    success(
+      await query('INSERT INTO items VALUES (?, ?, ?, UNHEX(?))', [
+        '9007199254740993',
+        '123456789012345678901234.123456',
+        "O'Brien\u4e2d\u6587",
+        '00FF4142',
+      ]),
+    );
+    final selected = await query(
+      'SELECT id, amount, note, bytes, NULL FROM items',
+    );
+    success(selected);
+    final row = (selected['rows'] as List).single as List;
+    require(
+      row[0] == '9007199254740993' &&
+          row[1] == '123456789012345678901234.123456',
+      'exact numeric values',
+    );
+    require(
+      row[2] == "O'Brien\u4e2d\u6587" && row[3] == '00FF4142' && row[4] == null,
+      'UTF-8 binary and NULL',
+    );
+    pass('prepared values, exact BIGINT/DECIMAL, UTF-8, binary and NULL');
+
+    final unchanged = await query('UPDATE items SET note=? WHERE id=?', [
+      row[2] as String,
+      row[0] as String,
+    ]);
+    success(unchanged);
+    require(unchanged['affectedRows'] == 1, 'matched unchanged update');
+    final mismatch = await query('SELECT ?');
+    require(
+      mismatch['available'] == true && mismatch['exitCode'] != 0,
+      'parameter mismatch rejected',
+    );
+    final syntax = await query('SELEC invalid');
+    require(
+      syntax['available'] == true &&
+          syntax['exitCode'] == 1064 &&
+          syntax['sqlState'] == '42000',
+      'SQL diagnostics',
+    );
+    final multiple = await query('SELECT 1; DROP TABLE items');
+    require(
+      multiple['available'] == true && multiple['exitCode'] != 0,
+      'query is one prepared statement',
+    );
+    pass('matched-row counts and real Oracle errors');
+
+    final transaction = await script(
+      'START TRANSACTION; UPDATE items SET note="rolled back"; ROLLBACK; SELECT note FROM items;',
+    );
+    success(transaction);
+    require(
+      transaction['results'] is List &&
+          (transaction['results'] as List).length == 4,
+      'ordered script results',
+    );
+    final afterRollback = await query('SELECT note FROM items');
+    require(
+      ((afterRollback['rows'] as List).single as List).single == row[2],
+      'transaction rollback',
+    );
+    final partial = await script(
+      'INSERT INTO items VALUES (2, 1, NULL, NULL); SELEC bad; INSERT INTO items VALUES (3, 1, NULL, NULL);',
+    );
+    require(
+      partial['available'] == true && partial['exitCode'] == 1064,
+      'partial script failure',
+    );
+    final count = await query('SELECT COUNT(*) FROM items');
+    require(
+      ((count['rows'] as List).single as List).single == '2',
+      'earlier statements executed; later ones did not',
+    );
+    pass('multi-statements, rollback and partial failure');
+
+    final limited = await runtime.invoke('query', {
+      'schema': 'lab',
+      'source': 'SELECT id FROM items ORDER BY id',
+      'params': <String?>[],
+      'rowLimit': 1,
+    });
+    success(limited);
+    require(
+      limited['truncated'] == true && (limited['rows'] as List).length == 1,
+      'row cap',
+    );
+    final drained = await script(
+      '${List.filled(130, 'SELECT 1;').join()} UPDATE items SET note="after cap" WHERE id=2;',
+    );
+    success(drained);
+    require(
+      drained['truncated'] == true &&
+          (drained['results'] as List).length == 128,
+      'result-set cap',
+    );
+    final afterCap = await query('SELECT note FROM items WHERE id=2');
+    require(
+      ((afterCap['rows'] as List).single as List).single == 'after cap',
+      'execution continues after display cap',
+    );
+    pass('display caps and complete native result draining');
+
+    final transportResult = await query('SELECT @@socket', [], '');
+    final socket = ((transportResult['rows'] as List).single as List).single;
+    final unauthorized = await MySqlFfi.invoke(args[1], {
+      'method': 'query',
+      'socket': socket,
+      'password': '',
+      'schema': '',
+      'source': 'SELECT 1',
+      'params': <String?>[],
+    });
+    require(
+      unauthorized['available'] == false && unauthorized['exitCode'] == 1045,
+      'empty password denied',
+    );
+    final missing = await MySqlFfi.invoke(args[1], {
+      'method': 'query',
+      'socket': '$socket.missing',
+      'password': '',
+      'schema': '',
+      'source': 'SELECT 1',
+      'params': <String?>[],
+    });
+    require(
+      missing['available'] == false && missing['exitCode'] != 0,
+      'no TCP fallback',
+    );
+    pass('private credentials and absent transport failure');
+
+    await runtime.stop();
+    runtime = createRuntime();
+    final persisted = await query(
+      'SELECT id, amount, bytes FROM items WHERE id=9007199254740993',
+    );
+    success(persisted);
+    require(
+      ((persisted['rows'] as List).single as List).join('|') ==
+          '9007199254740993|123456789012345678901234.123456|00FF4142',
+      'persistent data after new runtime',
+    );
+    final queued = query('SELECT SLEEP(0.2)');
+    final stopped = runtime.stop();
+    success(await queued);
+    await stopped;
+    success(await query('SELECT 1'));
+    await runtime.stop();
+    pass('persistence, serialized queries, shutdown and restart');
+
+    final marker = File(p.join(root.path, 'initialized.json'));
+    final original = await marker.readAsString();
+    final metadata = jsonDecode(original) as Map<String, dynamic>;
+    await marker.writeAsString(jsonEncode({...metadata, 'version': '8.0.0'}));
+    final invalid = await query('SELECT 1');
+    require(
+      invalid['available'] == false &&
+          invalid['error'].toString().contains('version does not match'),
+      'version mismatch rejected',
+    );
+    await marker.writeAsString(original);
+    pass('version mismatch prevents implicit database upgrade');
+
+    final child = await Process.start(Platform.resolvedExecutable, [
+      '--packages=${(await Isolate.packageConfig)!.toFilePath()}',
+      Platform.script.toFilePath(),
+      '--parent-server',
+      ...args.take(3),
+      root.path,
+    ]);
+    final childErrors = child.stderr.transform(utf8.decoder).join();
+    late final String ready;
+    try {
+      ready = await child.stdout
+          .transform(utf8.decoder)
+          .transform(const LineSplitter())
+          .first
+          .timeout(const Duration(seconds: 60));
+    } on Object {
+      child.kill(ProcessSignal.sigkill);
+      final status = await child.exitCode;
+      throw StateError(
+        'Parent-exit fixture failed ($status): ${await childErrors}',
+      );
+    }
+    require(ready.startsWith('READY '), 'child server ready: $ready');
+    final info = jsonDecode(ready.substring(6)) as Map;
+    child.kill(ProcessSignal.sigkill);
+    await child.exitCode;
+    await childErrors;
+    var exited = false;
+    for (var attempt = 0; attempt < 100; attempt++) {
+      final disconnected = await MySqlFfi.invoke(args[1], {
+        'method': 'query',
+        'socket': info['socket'],
+        'password': metadata['password'],
+        'schema': '',
+        'source': 'SELECT 1',
+        'params': <String?>[],
+      });
+      if (disconnected['available'] == false) {
+        exited = true;
+        break;
+      }
+      await Future<void>.delayed(const Duration(milliseconds: 100));
+    }
+    require(exited, 'native server stopped after app death');
+    pass('native launcher cleans server on abrupt application exit');
+    final recovery = await query('SELECT COUNT(*) FROM items');
+    success(recovery);
+    require(
+      ((recovery['rows'] as List).single as List).single == '2',
+      'InnoDB data recovered after application death',
+    );
+    await runtime.stop();
+    pass('persistent InnoDB data recovers after abrupt exit');
+    stdout.writeln(
+      '$passed/$passed Oracle lifecycle checks passed on ${Platform.operatingSystem}.',
+    );
+  } finally {
+    await runtime.stop();
+    // Keep real-engine data/logs for inspection rather than deleting evidence.
+    stdout.writeln('Fixture: ${root.path}');
+  }
+}
