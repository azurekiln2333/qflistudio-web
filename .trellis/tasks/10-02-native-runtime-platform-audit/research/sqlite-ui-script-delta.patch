+              continue;
+            }
+            final text = columnText(statement.value, index);
+            final length = columnBytes(statement.value, index);
+            if (text == nullptr || budget.bytes + length > 1024 * 1024) {
+              truncated = true;
+              break;
+            }
+            budget.bytes += length;
+            row.add(SqliteFfi._text(text, length: length));
+          }
