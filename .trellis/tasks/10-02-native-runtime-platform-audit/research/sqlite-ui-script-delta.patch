+                  utf8.encode(value).length,
+                  Pointer<Void>.fromAddress(-1),
+                );
+          if (code != 0) {
+            error = SqliteFfi._text(errorMessage(database));
+            break;
+          }
+        }
+        if (error.isNotEmpty) break;
