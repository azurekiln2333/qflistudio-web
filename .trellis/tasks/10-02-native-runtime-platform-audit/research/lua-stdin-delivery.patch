 #include <errno.h>
 #include <stdlib.h>
+#include <sys/stat.h>
 #include <wchar.h>
 #include <windows.h>
 
@@ -75,3 +76,14 @@ int qfli_utf8_rename(const char *source, const char *destination) {
   errno = saved_errno;
   return result;
 }
+
+int qfli_utf8_regular_file(const char *filename) {
+  wchar_t *wide_filename = wide_path(filename);
+  if (!wide_filename) return -1;
+  struct _stat64 info;
+  int result = _wstat64(wide_filename, &info);
+  int saved_errno = errno;
+  free(wide_filename);
+  errno = saved_errno;
+  return result < 0 ? -1 : ((info.st_mode & _S_IFMT) == _S_IFREG);
+}
