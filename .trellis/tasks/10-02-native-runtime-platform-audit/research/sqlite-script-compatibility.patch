+class SqlColumn {
+  const SqlColumn({
+    required this.name,
+    required this.type,
+    required this.notNull,
+    required this.primaryKey,
+    this.generated = false,
+    this.autoIncrement = false,
+  });
+
+  final String name;
+  final String type;
+  final bool notNull;
+  final bool primaryKey;
+  final bool generated;
+  final bool autoIncrement;
+}
+
+class SqlIndex {
+  const SqlIndex({
+    required this.name,
+    required this.columns,
+    required this.unique,
+    this.primary = false,
+  });
+
+  final String name;
+  final List<String> columns;
+  final bool unique;
+  final bool primary;
+}
+
+class SqlColumnDraft {
+  const SqlColumnDraft({
+    required this.name,
+    required this.type,
+    this.notNull = false,
+    this.primaryKey = false,
+  });
+
+  final String name;
+  final String type;
