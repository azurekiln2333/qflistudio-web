+            row.add(SqliteFfi._text(text, length: length));
+          }
+          if (truncated) break;
+          rows.add(row);
+          budget.rows++;
+        }
+      } while (false);
+    } finally {
+      if (statement.value != nullptr) finalize(statement.value);
+    }
+    return (
+      tail: tail.value,
+      hasStatement: hasStatement,
+      result: {
+        'available': true,
+        'exitCode': error.isEmpty ? 0 : 1,
+        'error': error,
+        'columns': columns,
+        'rows': rows,
+        'affectedRows': affectedRows,
+        'truncated': truncated,
+      },
+    );
+  }
+}
+
+Map<String, Object?> _emptyResult() => {
+  'available': true,
+  'exitCode': 0,
+  'error': '',
+  'columns': <String>[],
+  'rows': <List<String?>>[],
+  'affectedRows': 0,
+  'truncated': false,
+};
+
+class _Budget {
+  int rows = 0;
+  int bytes = 0;
+}
